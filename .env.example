# PayPal sandbox app "Doorman" (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Must exactly match the Return URL saved under Log in with PayPal > Advanced Settings.
# PayPal rejects "localhost", so use 127.0.0.1 and open the app at http://127.0.0.1:5173
PAYPAL_LOGIN_RETURN_URL=http://127.0.0.1:5173/auth/paypal/callback

# Free key from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=

# Neon Postgres connection string (needed in Phase 2)
DATABASE_URL=
